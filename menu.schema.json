{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MenuTalker Structured Menu",
  "description": "A structured restaurant menu used by MenuTalker for conversational ordering assistance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "currency", "categories"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "restaurant_name": {
      "type": ["string", "null"],
      "description": "Restaurant name if it is visible or strongly inferable from the menu."
    },
    "language": {
      "type": "string",
      "description": "Primary menu language as a BCP 47 tag, for example zh-TW, ja, en, or mixed."
    },
    "currency": {
      "type": "string",
      "description": "Currency code inferred from menu prices, for example TWD, JPY, USD, or UNKNOWN."
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/category"
      }
    },
    "notes": {
      "type": "array",
      "description": "Important menu-wide notes such as service charges, allergens, business rules, or OCR uncertainty.",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "items"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cat_[0-9]{2,}$"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": ["string", "null"]
        },
        "category_price": {
          "type": ["number", "null"],
          "description": "Fixed category-level price, usually for set meals or all-items-one-price sections."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/item"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^item_[0-9]{2,}_[0-9]{2,}$"
        },
        "name": {
          "type": "string"
        },
        "price": {
          "type": ["number", "null"]
        },
        "description": {
          "type": ["string", "null"]
        },
        "options": {
          "type": "array",
          "description": "Optional choices or modifiers for this item.",
          "items": {
            "$ref": "#/definitions/option_group"
          }
        },
        "is_recommended": {
          "type": "boolean",
          "default": false
        },
        "availability": {
          "type": ["string", "null"],
          "description": "Availability text such as sold out, limited, lunch only, or null."
        }
      }
    },
    "option_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "choices"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Option group name, for example size, spice level, ice, main dish choice, or drink choice."
        },
        "required": {
          "type": "boolean"
        },
        "min_select": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "max_select": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/option_choice"
          }
        }
      }
    },
    "option_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "additional_price": {
          "type": ["number", "null"],
          "default": 0
        }
      }
    }
  }
}
